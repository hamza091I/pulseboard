# Supabase project settings
# Get these values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local development URL used for Supabase email confirmation redirects.
# Keep this aligned with Supabase Dashboard > Authentication > URL Configuration.
# Site URL: http://localhost:3000

# Optional: only needed for trusted server-side scripts, never expose this in the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
